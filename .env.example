# Copie para .env e preencha. O .env é ignorado pelo git — nunca comite valores reais.
# Cada segredo de sessão precisa de no mínimo 32 bytes aleatórios e todos devem ser
# diferentes entre si. Gere cada um com:  openssl rand -hex 32

# ── Banco ────────────────────────────────────────────────────────────────────
# Casa com o docker-compose.yml deste repositório.
DATABASE_URL=mysql://root:dev@127.0.0.1:3306/ads_dashboard

# ── Sessões e cifra (obrigatórios) ───────────────────────────────────────────
JWT_SECRET=
MANAGER_JWT_SECRET=
OAUTH_STATE_SECRET=
INTEGRATION_ENCRYPTION_KEY=

# ── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Sem barra no final. Em produção, o domínio real.
PUBLIC_BASE_URL=http://localhost:3000

# ── Meta (necessário para investimento, CPL e ROAS) ──────────────────────────
# O painel de gestor também aceita colar um token direto, sem o fluxo OAuth.
META_APP_ID=
META_APP_SECRET=

# ── Importação do backup (temporária) ───────────────────────────────────────
# Defina apenas enquanto for carregar o backup pela tela /importar, com no
# mínimo 16 caracteres. REMOVA depois: sem ela a rota deixa de existir.
RESTORE_TOKEN=

# ── Integrações opcionais ────────────────────────────────────────────────────
# WhatsApp (Z-API) — envio de relatório
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Alertas operacionais
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Herdados da plataforma Manus ─────────────────────────────────────────────
# Só necessários enquanto os recursos de IA e storage do Manus forem usados.
# Fora do Manus, deixe em branco: os recursos que dependem deles ficam inativos.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
