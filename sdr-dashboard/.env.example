# ─── Banco ───────────────────────────────────────────────────────────────────
# Na Railway: DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL="mysql://usuario:senha@localhost:3306/sdr_dashboard"

# ─── Login ───────────────────────────────────────────────────────────────────
# Assina o cookie de sessão. Uma frase longa e aleatória (ao menos 32 caracteres).
# Trocar depois desconecta todo mundo, que precisa entrar de novo.
JWT_SECRET=""

# ─── Monday.com ──────────────────────────────────────────────────────────────
# Token pessoal da API. NUNCA colocar no frontend, no Git ou em documentos.
# O token antigo do Manus apareceu no código do navegador: revogue e gere um
# novo em Avatar > Developers > My access tokens.
MONDAY_API_TOKEN=""

# ─── Endereço público (opcional) ─────────────────────────────────────────────
# Domínio usado no link do portal enviado às clínicas, sem barra no final.
# Sem ele, o link usa o endereço de onde a SDR está acessando.
PUBLIC_APP_URL=""

# ─── WhatsApp pela Z-API (opcional) ──────────────────────────────────────────
# Com as três, a SDR envia o relatório direto no grupo da clínica. Sem elas,
# continua funcionando o botão "Abrir no WhatsApp".
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# ─── Temporárias: remova depois do uso ───────────────────────────────────────
# Ligam /importar (carregar o backup do Manus) e /recuperar (definir senha de
# uma conta). Ao menos 16 caracteres cada, senhas diferentes.
# RESTORE_TOKEN=""
# RECOVERY_TOKEN=""
