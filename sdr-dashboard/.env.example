# ─── Banco ───────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://usuario:senha@host:4000/sdr_dashboard"

# ─── Autenticação (Manus OAuth) ──────────────────────────────────────────────
JWT_SECRET=""
OAUTH_SERVER_URL=""
OWNER_OPEN_ID=""
VITE_APP_ID=""

# ─── Monday.com ──────────────────────────────────────────────────────────────
# Token pessoal da API. NUNCA colocar no frontend, no Git ou em documentos.
# O token anterior estava hardcoded em client/src/hooks/useMondayData.ts e foi
# publicado no bundle JS — ele precisa ser REVOGADO no Monday antes de subir
# qualquer coisa. Gere um novo em: Avatar > Developers > My access tokens.
MONDAY_API_TOKEN=""

# ─── Aplicação ───────────────────────────────────────────────────────────────
# Domínio público usado para montar o link do portal do cliente.
# Sem isso, o botão "Link do cliente" não aparece.
PUBLIC_APP_URL="https://sdrmaquinadevendas.manus.space"
